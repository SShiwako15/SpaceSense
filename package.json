{
  "name": "spacesense-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "npm ci && npm ci --prefix backend && npm ci --prefix frontend",
    "dev": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "node backend/src/server.js",
    "migrate": "npm run migrate --prefix backend",
    "test": "npm test --prefix backend",
    "test:postgres": "npm run test:postgres --prefix backend",
    "test:e2e": "playwright test",
    "demo:up": "docker compose up --build --detach --wait",
    "demo:down": "docker compose down",
    "demo:status": "docker compose ps",
    "demo:test": "docker compose --profile test run --build --rm test",
    "demo:e2e": "docker compose --profile test run --build --rm browser"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
